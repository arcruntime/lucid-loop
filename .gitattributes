# Normalize text files and store binary art/production assets in Git LFS.
* text=auto

# Keep the review runtime's recorded source hashes stable on Windows checkout.
Unity/Assets/CharacterArt/Runtime/RenCompleteHead*.cs text eol=lf
Unity/Assets/CharacterArt/Editor/RenCompleteHead*.cs text eol=lf
Unity/Assets/CharacterArt/Runtime/RenNprReview*.cs text eol=lf
Unity/Assets/CharacterArt/Editor/RenNprReview*.cs text eol=lf
Unity/Assets/CharacterArt/NPR/*.shader text eol=lf
Unity/Assets/CharacterArt/NPR/*.hlsl text eol=lf
Unity/Assets/CharacterArt/Runtime/RenHReference* text eol=lf
Unity/Assets/CharacterArt/Runtime/RenDesignerBlink*.cs text eol=lf
Unity/Assets/CharacterArt/Editor/RenDesignerBlink*.cs text eol=lf
Unity/Assets/CharacterArt/Editor/RenHReference* text eol=lf
art/generated/characters/ren/video-reference-v1/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Images and layered source artwork.
*.[pP][nN][gG] filter=lfs diff=lfs merge=lfs -text
*.[jJ][pP][gG] filter=lfs diff=lfs merge=lfs -text
*.[jJ][pP][eE][gG] filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.bmp filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text

# Models, audio, and video.
*.fbx filter=lfs diff=lfs merge=lfs -text
Unity/Assets/CharacterArt/Generated/RenBodyV3/Animations/RenObserverIdleFemaleV3.anim filter=lfs diff=lfs merge=lfs -text
Unity/Assets/CharacterArt/Generated/RenLOD0/Animations/*.anim filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
# Preserve exported material-library bytes for source hash checks.
*.mtl -text
*.blend filter=lfs diff=lfs merge=lfs -text
# These review records include hashes of other JSON records; keep checkout bytes stable.
art/generated/characters/ren/parts-workflow-v1/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
Unity/Assets/CharacterArt/Generated/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text

# Design archives and binary packages.
*.jam filter=lfs diff=lfs merge=lfs -text
*.fig filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text

# Managed Unity dependency binaries.
*.dll filter=lfs diff=lfs merge=lfs -text

# Unity serialization writes empty YAML values with a trailing space.
*.unity whitespace=-blank-at-eol
*.asset whitespace=-blank-at-eol
*.meta whitespace=-blank-at-eol
*.mat whitespace=-blank-at-eol
*.prefab whitespace=-blank-at-eol
# Dense diagnostic mesh assets; retain exact authored/imported bytes in LFS.
Unity/Assets/CharacterArt/Generated/RenCanonicalMorphRepair/**/*.asset filter=lfs diff=lfs merge=lfs -text
Unity/Assets/CharacterArt/Generated/RenTokonReview/Outline/*.asset filter=lfs diff=lfs merge=lfs -text
Unity/Assets/CharacterArt/Generated/RenDesignerBlinkReview/CanonicalPositionMeshes/*.asset filter=lfs diff=lfs merge=lfs -text
# Preserve upstream package formatting verbatim.
Unity/Assets/Plugins/R3/** whitespace=-blank-at-eol,-blank-at-eof

# Keep the pinned lip-sync dependency byte-identical to its SHA-256 manifest.
Unity/Assets/LiveSpeech/ThirdParty/Core/*.cs -text
Unity/Assets/LiveSpeech/ThirdParty/LICENSE.txt -text
Unity/Assets/LiveSpeech/ThirdParty/THIRD-PARTY-NOTICES.md -text
Unity/Assets/LiveSpeech/Resources/LiveSpeech/*.bytes -text

# Preserve bundled TMP Essentials and font-license formatting.
"Unity/Assets/TextMesh Pro/**" whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
Unity/Assets/Gyms/Resources/Victory/OFL.txt whitespace=-blank-at-eol
