+using System.Collections;
+namespace LucidLoop.Gyms.Mvp
+{
+    public sealed class CheckpointLoopResetAdapter : LoopResetAdapter
+    {
+        public FirstLoop Game;
+        public override bool CanTrigger=>Game && !TimeLoopTransitionController.InputBlocked;
+        public override int LoopNumber=>Game.State.Loop;
+        public override void BeginFreeze()=>Game.FreezeForTimeLoop();
+        public override IEnumerator RestoreCheckpoint(LoopResetResult result)
+        {
+            Game.RestoreTimeLoopCheckpoint();result.LoopNumber=LoopNumber;result.Success=true;yield break;
+        }
+        public override void EndFreeze(bool successful){if(Game)Game.FinishTimeLoop(successful);}
+    }
+}
