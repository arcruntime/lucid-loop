new file mode 100644
--- /dev/null
+++ b/Unity/Assets/Gyms/Runtime/Mvp/FirstLoop.TimeLoop.cs
@@ -0,0 +1,60 @@
+using System.Collections.Generic;
+using UnityEngine;
+namespace LucidLoop.Gyms.Mvp
+{
+    public partial class FirstLoop
+    {
+        TimeLoopTransitionController timeLoop;
+        readonly Dictionary<LoopRewindActor,LoopRewindActor.Pose> loopStartPoses=new Dictionary<LoopRewindActor,LoopRewindActor.Pose>();
+        public float LoopClock {get;private set;}
+        public void ConfigureTimeLoop(TimeLoopTransitionController controller)
+        {
+            timeLoop=controller;TimeLoopAutoSetup.ConfigureCommon(controller,Rig.Camera);
+            var activity=new List<Behaviour>(controller.WorldActivity);
+            foreach(var expanded in FindObjectsByType<ExpandedClub>(FindObjectsSortMode.None))if(!activity.Contains(expanded))activity.Add(expanded);
+            foreach(var backdrop in FindObjectsByType<PaintedBackdrop>(FindObjectsSortMode.None))if(!activity.Contains(backdrop))activity.Add(backdrop);
+            controller.WorldActivity=activity.ToArray();
+            var adapter=TimeLoopAutoSetup.Ensure<CheckpointLoopResetAdapter>(controller.gameObject);
+            adapter.Game=this;controller.ResetAdapter=adapter;
+            if(loopStartPoses.Count==0)foreach(var actor in controller.Actors)loopStartPoses[actor]=actor.Capture();
+            if(music){controller.Music=music.LoopSources;controller.ReturnMusicVolumes=new[]{music.Muted?0f:.36f,0f};}
+        }
+        void EnsureTimeLoop()
+        {
+            if(timeLoop)return;
+            var controller=FindFirstObjectByType<TimeLoopTransitionController>();
+            if(!controller)controller=new GameObject("Time loop transition").AddComponent<TimeLoopTransitionController>();
+            ConfigureTimeLoop(controller);
+        }
+#if UNITY_EDITOR
+        public void PrepareLoopValidation()
+        {StopAllCoroutines();CloseConversation();dialogue.gameObject.SetActive(false);Busy=false;}
+#endif
+        public void FreezeForTimeLoop()
+        {
+            // Invalidate story/chat coroutines and their delayed voice callbacks from this loop.
+            StopAllCoroutines();StopStoryLine();CloseConversation();
+            dialogue.gameObject.SetActive(false);Busy=true;approaching=null;advance=false;
+            if(music){music.TransitionOwnsAudio=true;timeLoop.ReturnMusicVolumes=new[]{music.Muted?0f:.36f,0f};}
+        }
+        public void RestoreTimeLoopCheckpoint()
+        {
+            foreach(var pair in loopStartPoses)
+            {if(!pair.Key)throw new System.InvalidOperationException("A checkpoint actor is missing.");pair.Key.Apply(pair.Value);}
+            foreach(var pair in starts)pair.Key.position=pair.Value;
+            foreach(var pair in rotations)pair.Key.rotation=pair.Value;
+            FocusRen=false;approaching=null;Luca.Visual.localRotation=Quaternion.identity;
+            phone.SetActive(false);followAt=Time.time+.3f;LoopClock=0;
+            if(music)music.RestoreLoopMix();
+            // Commit last. LoopState preserves remembered discoveries; conversations are retained.
+            State.Rewind();
+            foreach(var expanded in FindObjectsByType<ExpandedClub>(FindObjectsSortMode.None))expanded.RestoreLoopMaterial();
+        }
+        public void FinishTimeLoop(bool succeeded)
+        {
+            if(music)music.TransitionOwnsAudio=false;
+            Busy=false;modal=false;advance=false;approaching=null;Refresh();
+            if(succeeded)ObserverScene("Rewind · checkpoint restored","The new loop keeps your discoveries and restores the night.");
+        }
+    }
+}
